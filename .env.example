# Configuración local. NO subir a git (está en .gitignore). Las variables del entorno tienen prioridad.

# Base de datos de la aplicación (PostgreSQL local)
DATABASE_URL=
# Base EXCLUSIVA para pruebas (pytest -m postgres). Nunca la de la app ni la de producción.
TEST_DATABASE_URL=

# Frontend (CRIS-UNISIMON): enlaces de correos y redirecciones tras el login con Microsoft
FRONTEND_URL=
FRONTEND_LOGIN_PATH=

# Microsoft Entra ID (registro de aplicación de la universidad)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
# Faltan para habilitar el login con Microsoft:
# - el secreto del cliente (Azure > Registro de aplicaciones > Certificados y secretos)
MICROSOFT_CLIENT_SECRET=
# - la URL de retorno; debe estar registrada IGUAL en Azure (plataforma "Web"), p.ej. en local:
#   http://localhost:5173/news-api/auth/microsoft/callback   (pasa por el proxy del frontend: misma cookie)
MICROSOFT_REDIRECT_URI=
MICROSOFT_POST_LOGOUT_REDIRECT_URI=
